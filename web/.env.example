# Google Street View Static API (sunucu tarafı)
GOOGLE_STREET_VIEW_API_KEY=

# Görüntü çözünürlüğü — Google SV max 640×640 (daha büyük istek kırpılır)
STREET_VIEW_IMAGE_SIZE=640x640

# Hugging Face Inference API token (sunucu tarafı)
HUGGINGFACE_API_TOKEN=

# Aşama 1 — zero-shot görüntü tanıma (OWLv2)
HF_VISION_DETECTION_MODEL=google/owlv2-large-patch14-ensemble
HF_DETECTION_THRESHOLD=0.28

# Grounding DINO — HF Inference Endpoints (opsiyonel, OWLv2'den üstün)
# Kurulum: huggingface.co/inference-endpoints → IDEA-Research/grounding-dino-base
HF_GROUNDING_DINO_ENDPOINT=
HF_GROUNDING_DINO_THRESHOLD=0.32

# Arbiter Agent — tutarlılık ve ekip uyumu
HF_ARBITER_MODEL=Qwen/Qwen2.5-7B-Instruct

# Yedek klasik nesne tespiti (DETR)
HF_DETR_MODEL=facebook/detr-resnet-101

# Kapsamlı rapor — HF metin modeli
HF_REPORT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_SYNTHESIS_MODEL=Qwen/Qwen2.5-7B-Instruct

# İnteraktif 360° Street View (Maps Embed API, istemci)
NEXT_PUBLIC_MAPS_EMBED_KEY=

# Go backend — dolu ise login zorunlu + benchmark kayıt
NEXT_PUBLIC_BACKEND_URL=

# Benchmark script (npm run benchmark)
BENCHMARK_BASE_URL=http://localhost:3000
BACKEND_URL=
