# Google Street View Static API anahtarı (yalnızca sunucu tarafı, istemciye açılmaz)
GOOGLE_STREET_VIEW_API_KEY=

# Hugging Face Inference API token'ı (sunucu tarafı). "Inference Providers" izni gerekir.
HUGGINGFACE_API_TOKEN=

# BİRİNCİL görsel analiz: ücretsiz HF multimodal (vision-language) modeli.
# Dört yönün görselini tek istekte değerlendirir ve durum (çöp/yol hasarı/...)
# tespiti yapar. Varsayılan: Qwen/Qwen3-VL-8B-Instruct.
HF_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Son yedek: HF Hub üzerindeki nesne tespiti modeli (COCO). Varsayılan:
# facebook/detr-resnet-50.
HF_DETECTION_MODEL=facebook/detr-resnet-50

# Gemini multimodal görsel analiz anahtarı (YEDEK; HF vision birincildir).
# Google AI Studio'dan alınan "AIza..." anahtarı olmalı; "Generative Language
# API" etkin olmalıdır. Boş/çalışmazsa doğrudan HF vision kullanılır.
GEMINI_API_KEY=
# İsteğe bağlı: kullanılacak Gemini görsel modeli (varsayılan gemini-2.0-flash).
GEMINI_VISION_MODEL=gemini-2.0-flash

# Google Cloud Vision API anahtarı — ikinci yedek görüntü analizi.
# Boş bırakılırsa GOOGLE_STREET_VIEW_API_KEY denenir.
# Google Cloud'da "Cloud Vision API" etkin olmalıdır.
GOOGLE_VISION_API_KEY=

# İnteraktif 360° Street View için istemciye açılan harita anahtarı.
# Google Cloud'da "Maps Embed API" etkin olmalıdır. Boş bırakılırsa 360°
# görünüm gizlenir, yalnızca dört yön statik görselleri gösterilir.
NEXT_PUBLIC_MAPS_EMBED_KEY=

# Go backend (masterfabric-go) adresi — Render deploy sonrası:
# https://zephyr-backend-2mtm.onrender.com
# Ayarlanırsa login/session zorunlu olur ve kayıtlar JWT ile backend'e
# senkronlanır. Boş bırakılırsa yalnızca localStorage (demo modu).
NEXT_PUBLIC_BACKEND_URL=https://zephyr-backend-2mtm.onrender.com
